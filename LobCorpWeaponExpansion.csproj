<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <AssemblyName>LobCorpWeaponExpansion</AssemblyName>
    <RootNamespace>LobCorpWeaponExpansion</RootNamespace>
    <Version>0.2.0</Version>

    <Deterministic>true</Deterministic>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>

    <GameDir Condition="'$(GameDir)' == '' and '$(SEPHIRIA_GAME_DIR)' != ''">$(SEPHIRIA_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">D:\Steam\steamapps\common\Sephiria</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Mirror">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Mirror.Components">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Mirror.Components.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameDir)\Sephiria_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateSephiriaGameDir" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(GameDir)\Sephiria_Data\Managed\Assembly-CSharp.dll')"
      Text="Cannot find Assembly-CSharp.dll. Set GameDir or SEPHIRIA_GAME_DIR." />

    <Error
      Condition="!Exists('$(GameDir)\Sephiria_Data\Managed\0Harmony.dll')"
      Text="Cannot find the built-in 0Harmony.dll under Sephiria_Data\Managed." />

    <Error
      Condition="!Exists('$(GameDir)\Sephiria_Data\Managed\Mirror.dll')"
      Text="Cannot find Mirror.dll under Sephiria_Data\Managed." />
  </Target>
</Project>